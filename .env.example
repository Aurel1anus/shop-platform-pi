API_ADDR=:8081
APP_ENV=development
MYSQL_DSN='root:root@tcp(127.0.0.1:3307)/xzxg_commerce?parseTime=true&loc=Local'
RUN_MIGRATIONS=true
SEED_DEMO_DATA=true
COMMERCE_HTTP_CORS_ALLOWED_ORIGINS=*
COMMERCE_MINIO_ENDPOINT=127.0.0.1:9100
COMMERCE_MINIO_ACCESS_KEY=minioadmin
COMMERCE_MINIO_SECRET_KEY=minioadmin
COMMERCE_MINIO_BUCKET=xzxg-commerce-assets
COMMERCE_MINIO_USE_SSL=false
# Optional. Without Nacos, admin configuration changes live in memory until restart.
# NACOS_ADDR=http://127.0.0.1:18848
# ECOMMERCE_DATASET_ROOT=/absolute/path/to/shop-platform/quality/data/ecommerce_agent_dataset
# AVATAR_UPLOAD_ROOT=/absolute/path/to/uploads/avatar
# Optional speech credentials; no model credentials are needed for the commerce API.
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# Future Pi commerce tools; currently shown only by shop_status.
COMMERCE_API_BASE_URL=http://127.0.0.1:8081/api/v1
