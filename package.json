{
  "name": "xzxg-shop-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "pi": "pi",
    "chat": "node scripts/pi.mjs",
    "check": "node scripts/pi.mjs --check",
